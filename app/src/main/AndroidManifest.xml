<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Pomoc: zavolat rodině a poslat, kde senior je -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Léky a Jsem v pořádku: připomenout na minutu přesně -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Aby aplikace poznala, jestli je v telefonu WhatsApp nebo Messenger nebo jiný chat (jinak krok přeskočí) -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.mlite" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.viber.voip" />
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:label="Postaráno"
        android:icon="@drawable/ic_shield"
        android:roundIcon="@drawable/ic_shield"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:allowBackup="true"
        android:fullBackupContent="@xml/zaloha"
        android:dataExtractionRules="@xml/zaloha_nova">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Požadavek Androidu na aplikaci pro zprávy -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <activity android:name=".DruhyNazorActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".DnSetupActivity" android:exported="false" />
        <activity android:name=".MessageActivity" android:exported="false" />
        <activity android:name=".PolicyActivity" android:exported="false" />
        <activity
            android:name=".LetterActivity"
            android:exported="true"
            android:label="Přečíst dopis"
            android:icon="@drawable/ic_shield"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait">
            <!-- Dopis poslaný z Fotek, Souborů nebo e-mailu přes Sdílet -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <receiver android:name=".LetterReminderReceiver" android:exported="false" />
        <receiver android:name=".CareReceiver" android:exported="false" />
        <receiver android:name=".FamilyMailReceiver" android:exported="false" />
        <receiver android:name=".WeatherReceiver" android:exported="false" />
        <activity android:name=".QuizActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".BenefitsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".RadioActivity" android:exported="false" android:launchMode="singleTop" android:screenOrientation="portrait" />
        <activity
            android:name=".WeatherActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name=".FamilyMailActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <receiver android:name=".PomocWidget" android:exported="false" android:label="Pomoc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pomoc" />
        </receiver>
        <activity
            android:name=".CareActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="cz.druhynazor.pece"
            android:screenOrientation="portrait" />
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />
        <receiver android:name=".MmsSentReceiver" android:exported="false" />

        <!-- Připravená MMS s fotkou dopisu pro rodinu (čte ji jen telefon při odesílání) -->
        <provider
            android:name=".MmsFileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Čtení textu dopisu přímo v telefonu (bez internetu) -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr" />

        <activity
            android:name=".ScamCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="cz.druhynazor.varovani" />

        <activity
            android:name=".QuestionActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name=".HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <service
            android:name=".ScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hlídání konce hovorů s neznámými čísly kvůli ochraně seniorů před podvody" />
        </service>

        <service
            android:name=".ChatWatcher"
            android:exported="true"
            android:label="Postaráno – kontrola chatů"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
